<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>localizacion</name>
  <version>0.1.0</version>
  <description>Semana 06 del Challenge JAR: Filtro de partículas y localización en el mapa.</description>
  <maintainer email="rafadiaz71@gmail.com">AIR Club UdeSA</maintainer>
  <license>MIT</license>

  <!-- Dependencias base de ROS 2 para este nodo -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Dependencias de Python puro (agregadas según las instrucciones) -->
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>